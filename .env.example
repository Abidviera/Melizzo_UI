# Copy this file to .env and fill in your real values
# .env is already in .gitignore — it will NEVER be committed

# API Configuration
API_URL=https://your-production-api.com
WHATSAPP_SERVICE_URL=https://wa.me/1234567890

# Optional: Encryption keys for runtime data
APP_ENCRYPTION_KEY=your-256-bit-key-here

# Optional: Third-party API keys
SOME_THIRD_PARTY_KEY=your-key-here
